# OpenBCI MCP environment (copy to .env)

OPENBCI_MCP_PORT=10759
OPENBCI_SERIAL_PORT=COM3
OPENBCI_BOARD_ID=0

# OSC trigger default target (osc-mcp listener, VRChat, Reaper, etc.)
OPENBCI_OSC_HOST=127.0.0.1
OPENBCI_OSC_PORT=9000

# Optional: persist trigger rules
# OPENBCI_TRIGGERS_FILE=C:/Users/you/.openbci-mcp/triggers.json

# Synthetic probe at startup (no hardware)
# OPENBCI_PROBE=1
