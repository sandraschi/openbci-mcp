{
  // Pyright gate (fleet five-gate standard). BrainFlow/DataFilter are optional
  // native deps imported under try/except, so narrowing rules that assume
  // "None means always-None" are warnings here, not errors. Call sites are
  // covered by tests/test_board_manager.py + tests/test_triggers.py instead.
  // reportArgumentType is also warning-only: brainflow's C-extension stubs
  // disagree with runtime behavior (e.g. get_avg_band_powers call shape in
  // board_manager.band_power, which is covered by test_triggers.py and returns
  // correct values live). Do not "fix" call sites to satisfy stubs without a
  // hardware-verified double-check — see tracking issue.
  "typeCheckingMode": "basic",
  "reportOptionalCall": "warning",
  "reportOptionalMemberAccess": "warning",
  "reportCallIssue": "warning",
  "reportArgumentType": "warning"
}
